# Application URL (injected at runtime in hosted environments)
APP_URL="https://nimaiengineering.com"

# Server port (defaults to 3000)
PORT="3000"

# Optional webhook / email relay URL for forwarding submitted enquiries
# (e.g. Formspree, Make, Zapier, or company SMTP relay endpoint)
ENQUIRY_WEBHOOK_URL=""

# Optional custom API endpoint for static Firebase Hosting deployments
# Leave blank when serving via the included Express server.ts
VITE_ENQUIRY_API_URL=""
